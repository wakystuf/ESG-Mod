  <!-- Weapon Types -->
  <LocalizationPair Name="%WeaponTypeBroadsideTitle">Arme à bordée</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeBroadsideEffect">Ceci est un emplacement à bordée ; une arme placée ici disposera de deux arcs de tir de 120 degrés centrés directement sur la gauche et la droite du vaisseau.</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeTurretTitle">Arme de tourelle</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeTurretEffect">Ceci est un emplacement de tourelle ; une arme placée ici disposera d'un arc de tir de 270 degrés centré directement vers l'avant du vaisseau.</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeLargeTitle">Arme lourde</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeLargeEffect">Ceci est un emplacement lourd ; les montages lourds accueillent une seule grande arme infligeant quatre fois les dégâts et tirant deux fois moins vite qu'un montage d'arme classique, soit un DPS effectif doublé. Les armes de DCA sont beaucoup moins efficaces contre les missiles et les escadrons dans cet emplacement.</LocalizationPair>

