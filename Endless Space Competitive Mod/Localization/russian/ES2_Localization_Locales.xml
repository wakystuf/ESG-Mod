  <!-- Academy Role Descriptions -->
  <LocalizationPair Name="%AcademyRoleLibrarianDescription">Имея доступ как к древним, так и к недавним исследованиям и данным, Библиотекарь может находить ответы на сложные вопросы, открывать передовые технологии и очень эффективно внедряться в сети.</LocalizationPair>
  <LocalizationPair Name="%AcademyRoleLibrarianEffectOverride">Библиотекарь может получить доступ к скрытой информации, доступной только Академии, такой как данные о состоянии героев и других империй, критических уязвимостях взлома в сетевых протоколах и кэше научной информации, позволяющем исследовать технологии на один этап выше обычного.</LocalizationPair>
  <LocalizationPair Name="%AcademyRoleGrandAdmiralDescription">Копье Исиандера — лидер флотов Академии и лично командует одним из крупнейших, а также получает доступ к академическим стрелкам и пилотам эскадронов.</LocalizationPair>
  <LocalizationPair Name="%AcademyRoleGrandAdmiralEffectOverride">Копье Исиандера может напрямую командовать Главным флотом атаки Академии и получает +5% к урону модулей за каждую разблокированную военную эпоху.</LocalizationPair>
  <LocalizationPair Name="%AcademyRoleVaultKeeperDescription">Хранитель Хранилищ не охраняет сокровища Академии, а управляет обширной, безопасной инфраструктурой, которая отслеживает правила и нормы галактики. Эта должность дает повышенную политическую значимость.</LocalizationPair>
  <LocalizationPair Name="%AcademyRoleVaultKeeperEffectOverride">Хранитель Хранилищ имеет доступ ко всем законам дополнительной партии по своему выбору (за исключением супер-закона), а прирост радиуса влияния увеличивается на 10% по всей империи.</LocalizationPair>

  <!-- Spelling fixes -->
  <LocalizationPair Name="%DiplomaticInteractionAppeasementForcedPeaceFromColdWarAfraidVaulters">Я ожидал флоты кораблей, а не предложение мира. Не скрою, что Ауриганы почувствовали облегчение.</LocalizationPair>
  <LocalizationPair Name="%TechnologyDefinitionEmpireDevelopment13Description">Создание наномашин — или нанитов — способных работать в жидких средах с различными условиями солености, температуры, давления и микробной жизни, имеет множество потенциальных применений. Исследования в области источников энергии, движения и самовосстановления позволяют разработать целую экологию этих жидких нанитов.</LocalizationPair>
  <LocalizationPair Name="%TechnologyDefinitionEmpireDevelopment13VampirilisTitle">Нано Аквакультура</LocalizationPair>
  <LocalizationPair Name="%TechnologyDefinitionEmpireDevelopment13VampirilisDescription">Создание одобренных Церковью наномашин — или нанитов — способных работать в жидких средах с различными условиями солености, температуры, давления и микробной жизни, имеет множество потенциальных применений. Исследования в области источников энергии, движения и самовосстановления позволяют разработать целую экологию этих жидких нанитов.</LocalizationPair>
  <LocalizationPair Name="%SiegePowerTitle">Осада запасов [foodColored]/[industryColored] аванпоста / [turn]</LocalizationPair>

  <!-- Garrison Button -->
  <LocalizationPair Name="%FleetDisbandDescription">Разместить флот в гарнизоне и пришвартовать его в ангаре текущей звездной системы для быстрого ремонта и пополнения. Вы можете размещать гарнизон только в своей звездной системе.</LocalizationPair>
  <LocalizationPair Name="%FleetDisbandTitle">Гарнизон</LocalizationPair>

  <!-- Quest -->
  <LocalizationPair Name="%SophonsQuest-Chapter2.1-Military-C1Step1Objective">Поддерживать $AmountLoc [militaristColored] #B82738#Милитаристских#REVERT# закон(ов) в течение $DurationName [turn].</LocalizationPair>
  <LocalizationPair Name="%SophonsQuest-Chapter2.1-Military-C1Step1ObjectiveTooltip">Чтобы увеличить милитаристскую политическую идеологию: строить корабли, оборону, быть агрессивным с другими фракциями.</LocalizationPair>

  <!-- Weapon Types -->
  <LocalizationPair Name="%WeaponTypeBroadsideTitle">Орудие бортового залпа</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeBroadsideEffect">Это слот бортового залпа; оружие, размещенное здесь, будет иметь две зоны обстрела по 120 градусов, направленные прямо влево и вправо от корабля.</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeTurretTitle">Башенное орудие</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeTurretEffect">Это слот башни; оружие, размещенное здесь, будет иметь зону обстрела в 270 градусов, направленную прямо вперед от корабля.</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeLargeTitle">Тяжелое орудие</LocalizationPair>
  <LocalizationPair Name="%WeaponTypeLargeEffect">Это тяжелый слот; тяжелые установки содержат одно крупное оружие с четырехкратным уроном и вдвое меньшей скорострельностью по сравнению с обычной установкой, что дает вдвое больший DPS. Оружие ПВО гораздо менее эффективно против ракет и эскадронов в этом слоте.</LocalizationPair>

