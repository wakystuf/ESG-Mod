  <!-- Scale Supremacy -->
  <LocalizationPair Name="%SettingScaleSupremacyVictoryTitle">Масштабируемая победа через господство</LocalizationPair>
  <LocalizationPair Name="%SettingScaleSupremacyVictoryDescription">Включение дает защитные бонусы игрокам не в альянсе, чтобы масштабирование работало как для других типов побед.</LocalizationPair>
  <LocalizationPair Name="%SettingScaleSupremacyVictoryTrueTitle">Включено</LocalizationPair>
  <LocalizationPair Name="%SettingScaleSupremacyVictoryTrueDescription">Домашние системы получат защитные бонусы, зависящие от числа игроков, и теряют их за каждого члена альянса.</LocalizationPair>
  <LocalizationPair Name="%SettingScaleSupremacyVictoryFalseTitle">Выключено</LocalizationPair>
  <LocalizationPair Name="%SettingScaleSupremacyVictoryFalseDescription">Домашние системы не получат защитных бонусов в зависимости от числа игроков и не теряют их за членов альянса.</LocalizationPair>
  <LocalizationPair Name="%StarSystemImprovementHomeSystemOverride">+100% к здоровью войск [moins] (% игроков в галактике в вашем Альянсе)</LocalizationPair>

  <!-- Tradeable Curiosity Techs-->
  <LocalizationPair Name="%SettingSettingTradeableCuriosityTechsTitle">Торгуемые технологии любопытства</LocalizationPair>
  <LocalizationPair Name="%SettingSettingTradeableCuriosityTechsDescription">Включение позволяет обменивать редкие модули и улучшения систем между игроками.</LocalizationPair>
  <LocalizationPair Name="%SettingSettingTradeableCuriosityTechsTrueTitle">Включено</LocalizationPair>
  <LocalizationPair Name="%SettingSettingTradeableCuriosityTechsTrueDescription">Технологии любопытства можно обменивать.</LocalizationPair>
  <LocalizationPair Name="%SettingSettingTradeableCuriosityTechsFalseTitle">Выключено</LocalizationPair>
  <LocalizationPair Name="%SettingSettingTradeableCuriosityTechsFalseDescription">Технологии любопытства нельзя обменивать.</LocalizationPair>

  <!-- Terraform Size -->
  <LocalizationPair Name="%SettingTerraformSizeTitle">Включить терраформирование размера</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformSizeDescription">Включение позволяет терраформировать планеты для увеличения размера. Отключение делает поведение стандартным. Включение свободного терраформирования позволит уменьшать размер планет.</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformSizeTrueTitle">Включено</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformSizeTrueDescription">Вы сможете изменять размер планет.</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformSizeFalseTitle">Выключено</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformSizeFalseDescription">Вы не сможете изменять размер планет.</LocalizationPair>

  <!-- Terraform Jovian -->
  <LocalizationPair Name="%SettingTerraformJovianTitle">Включить терраформирование юпитерианских планет</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformJovianDescription">Включение позволяет терраформировать газовые планеты. Отключение запрещает это. Включение свободного терраформирования позволит преобразовывать планеты между теллурическими и юпитерианскими.</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformJovianTrueTitle">Включено</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformJovianTrueDescription">Вы сможете терраформировать газовые планеты.</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformJovianFalseTitle">Выключено</LocalizationPair>
  <LocalizationPair Name="%SettingTerraformJovianFalseDescription">Вы не сможете терраформировать газовые планеты.</LocalizationPair>

  <!-- Create Sanctuary via Hacking -->
  <LocalizationPair Name="%SettingHackingUmbralSanctuariesOnHomeSystemsTitle">Разрешить создание убежищ на домашних системах через взлом</LocalizationPair>
  <LocalizationPair Name="%SettingHackingUmbralSanctuariesOnHomeSystemsDescription">Включение позволяет Теневому Хору создавать убежища на системах, необходимых для победы через господство. Отключение предотвращает возможные злоупотребления.</LocalizationPair>
  <LocalizationPair Name="%SettingHackingUmbralSanctuariesOnHomeSystemsTrueTitle">Включено</LocalizationPair>
  <LocalizationPair Name="%SettingHackingUmbralSanctuariesOnHomeSystemsTrueDescription">Вы сможете создавать убежища на домашних системах основных фракций.</LocalizationPair>
  <LocalizationPair Name="%SettingHackingUmbralSanctuariesOnHomeSystemsFalseTitle">Выключено</LocalizationPair>
