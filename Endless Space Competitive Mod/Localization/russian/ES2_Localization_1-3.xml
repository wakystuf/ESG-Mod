  <!-- Enable ESG Content -->
  <LocalizationPair Name="%SettingEnableESGContentTitle">Включить контент ESG</LocalizationPair>
  <LocalizationPair Name="%SettingEnableESGContentDescription">Мод ESG иногда добавляет контент, а не только баланс. Отключение позволит играть без этого контента. В основном это включает модули, улучшения систем и империи.</LocalizationPair>
