<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">
  <SimulationDescriptor Name="ClassModuleWeaponEnergyCoilgun" Type="ClassModuleWeapon">
    <Modifier TargetProperty="WeaponTypePhysical"           Operation="Addition"        Value="1"         Path="ClassModuleWeapon" TooltipHidden="true"/>

    <Modifier TargetProperty="Cooldown"                     Operation="Addition"        Value="1"         Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="PreparationDuration"          Operation="Addition"        Value="0.1"       Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="PreparationDurationFactorMin" Operation="Multiplication"  Value="1"         Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="PreparationDurationFactorMax" Operation="Multiplication"  Value="1"         Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="ShootingDuration"             Operation="Addition"        Value="0.8"       Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="ShotsCountPerSalvo"           Operation="Addition"        Value="1"         Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="ProjectileSpeed"              Operation="Addition"        Value="125"       Path="ClassModuleWeapon" TooltipHidden="true"/>

    <Modifier TargetProperty="CriticalHitChance"            Operation="Addition"        Value="0"         Path="ClassModuleWeapon" />
    <Modifier TargetProperty="ShieldPenetrationFactor"      Operation="Addition"        Value="0"         Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="HullPlatingPenetrationFactor" Operation="Addition"        Value="1"         Path="ClassModuleWeapon" TooltipHidden="true"/>

    <Modifier TargetProperty="LongRangePenalty"             Operation="Addition"        Value="0.7"       Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="MediumRangePenalty"           Operation="Addition"        Value="0.05"      Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="ShortRangePenalty"            Operation="Addition"        Value="0.35"      Path="ClassModuleWeapon" TooltipHidden="true"/>
    <Modifier TargetProperty="DeadZoneRangePenalty"         Operation="Addition"        Value="1"         Path="ClassModuleWeapon" TooltipHidden="true"/>

    <!--Every time a module is installed, the upkeep grows-->
    <Modifier TargetProperty="GarrisonMoneyUpkeep"          Operation="Addition" Value="$(UpkeepFromModules)"    Path="../ClassShip"/>

    <Modifier TargetProperty="DamagePerSecondKinetic"       Operation="Addition" Value="$(DamagePerSecond)"         Path="../ClassShip"/>

    <Modifier TargetProperty="OffensiveMilitaryPower"  Operation="Multiplication" Value="2"  Path="ClassModuleWeapon" TooltipHidden="true" Priority="0"/>
  </SimulationDescriptor>

  <!-- White -->
  <SimulationDescriptor Name="ModuleWeaponCoilgun1"  Type="ModuleWeapon">
    <Modifier TargetProperty="Damage"                    Operation="Addition" Value="6"  TooltipHidden="true"/>
    <Modifier TargetProperty="ArmorDestructionFlat"      Operation="Addition" Value="2.5"   TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalIndustryCost"   Operation="Addition" Left="$(WeaponIndustryTier2)" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="SalvoEnergyCoilgun1" Type="Salvo">
    <Modifier TargetProperty="MaximumHealth" Operation="Addition" Value="250" Path="ClassSalvo"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="ModuleWeaponCoilgun2"  Type="ModuleWeapon">
    <Modifier TargetProperty="Damage"                    Operation="Addition" Value="8"  TooltipHidden="true"/>
    <Modifier TargetProperty="ArmorDestructionFlat"      Operation="Addition" Value="4"     TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalIndustryCost"   Operation="Addition" Left="$(WeaponIndustryTier3)" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="SalvoEnergyCoilgun2" Type="Salvo">
    <Modifier TargetProperty="MaximumHealth" Operation="Addition" Value="250" Path="ClassSalvo"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="ModuleWeaponCoilgun3"  Type="ModuleWeapon">
    <Modifier TargetProperty="Damage"                    Operation="Addition" Value="10"  TooltipHidden="true"/>
    <Modifier TargetProperty="ArmorDestructionFlat"      Operation="Addition" Value="5.5"    TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalIndustryCost"   Operation="Addition" Left="$(WeaponIndustryTier4)" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="SalvoEnergyCoilgun3" Type="Salvo">
    <Modifier TargetProperty="MaximumHealth" Operation="Addition" Value="250" Path="ClassSalvo"/>
  </SimulationDescriptor>

  <!-- Strategic -->
  <SimulationDescriptor Name="ModuleWeaponCoilgun1Strategic"  Type="ModuleWeapon">
    <Modifier TargetProperty="Damage"                    Operation="Addition" Value="12"    TooltipHidden="true"/>
    <Modifier TargetProperty="ArmorDestructionFlat"      Operation="Addition" Value="6"     TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalIndustryCost"   Operation="Addition" Left="$(WeaponIndustryTier3)" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalStrategic2Cost" Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="SalvoEnergyCoilgun1Strategic" Type="Salvo">
    <Modifier TargetProperty="MaximumHealth" Operation="Addition" Value="250" Path="ClassSalvo"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="ModuleWeaponCoilgun2Strategic"  Type="ModuleWeapon">
    <Modifier TargetProperty="Damage"                    Operation="Addition" Value="14"   TooltipHidden="true"/>
    <Modifier TargetProperty="ArmorDestructionFlat"      Operation="Addition" Value="8.25"     TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalIndustryCost"   Operation="Addition" Left="$(WeaponIndustryTier4)" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalStrategic4Cost" Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="SalvoEnergyCoilgun2Strategic" Type="Salvo">
    <Modifier TargetProperty="MaximumHealth" Operation="Addition" Value="250" Path="ClassSalvo"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="ModuleWeaponCoilgun3Strategic"  Type="ModuleWeapon">
    <Modifier TargetProperty="Damage"                    Operation="Addition" Value="16"   TooltipHidden="true"/>
    <Modifier TargetProperty="ArmorDestructionFlat"      Operation="Addition" Value="10.5"     TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalIndustryCost"   Operation="Addition" Left="$(WeaponIndustryTier5)" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
    <BinaryModifier TargetProperty="TotalStrategic6Cost" Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Multiplier)" Path="ClassModuleWeapon" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="SalvoEnergyCoilgun3Strategic" Type="Salvo">
    <Modifier TargetProperty="MaximumHealth" Operation="Addition" Value="250" Path="ClassSalvo"/>
  </SimulationDescriptor>
</Datatable>